# Server Configuration
PORT=3001
# Frontend URL (for CORS and email links)
# For single origin: FRONTEND_URL=https://yourdomain.com
# For multiple origins: use CORS_ORIGINS instead (comma-separated)
FRONTEND_URL=http://localhost:3000
# CORS Origins (optional - comma-separated list for multiple allowed origins)
# Example: CORS_ORIGINS=https://app.yourdomain.com,https://www.yourdomain.com
# If not set, uses FRONTEND_URL as single origin
# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# MongoDB Connection (MongoDB Atlas in production)
# Example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/hashenv?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/hashenv

# JWT Secret (change this in production)
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# Master Encryption Key (base64-encoded 32-byte key)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ROOT_ENCRYPTION_KEY=your-base64-encoded-32-byte-key-here

# MongoDB TLS (optional — auto-detected from mongodb+srv:// or tls=true in URI)
# MONGODB_TLS=false

# Email Configuration (SEND-ONLY - No email receiving functionality)
# This service only sends transactional emails (verification, password reset, invites)
# It does NOT receive or process incoming emails
#
# SMTP via nodemailer. Example for Gmail:
# - Use your Gmail address as SMTP_USER
# - Use an App Password (not your regular password) as SMTP_PASSWORD
# - Generate App Password: Google Account > Security > 2-Step Verification > App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here
SMTP_FROM=your-email@gmail.com
SMTP_DISPLAY_NAME=HashEnv

# Environment
NODE_ENV=development
